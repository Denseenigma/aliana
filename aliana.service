[Unit]
Description=Aliana recon dashboard
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/aliana
Environment=ALIANA_IFACE=usb0
Environment=ALIANA_SCAN_INTERVAL=300
# Automatic scans start OFF; switch them on from the dashboard / Pi screen
Environment=ALIANA_AUTO_SCAN=0
# Passive discovery (passive.py) listens for DHCP/ARP/mDNS announcements:
# needs raw sockets. Listen-only; nothing is sent.
# Port 80 is only used while the phone Wi-Fi setup hotspot runs (it sends
# phones to the Wi-Fi page).
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
ExecStart=/home/admin/aliana/venv/bin/python3 /home/admin/aliana/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
